# ============================================================================
# VARIABLES DE EJEMPLO PARA EL MÓDULO S3 BUCKETS CORE
# ============================================================================

# Variables obligatorias
client      = "pragma"
project     = "webapp"
environment = "dev"

# ============================================================================
# CONFIGURACIÓN DE EJEMPLO
# ============================================================================
# 
# Este archivo muestra ejemplos de configuración para diferentes tipos de buckets.
# Copia este archivo a terraform.tfvars y modifica según tus necesidades.
#
# IMPORTANTE: 
# - Todos los buckets tendrán cifrado habilitado por defecto
# - El acceso público estará bloqueado por defecto por seguridad
# - Los nombres se generan automáticamente: {client}-{project}-{environment}-s3-{key}
#
# ============================================================================

# Ejemplo de configuración básica (descomenta para usar)
# s3_buckets_config = {
#   "uploads" = {
#     force_destroy = true  # Solo para desarrollo/testing
#     
#     # Cifrado básico
#     encryption_enabled = true
#     encryption_type    = "AES256"
#     
#     # Versionado
#     versioning_enabled = true
#     
#     # Lifecycle básico
#     lifecycle_rules = [
#       {
#         id     = "basic-lifecycle"
#         status = "Enabled"
#         
#         transition_ia_days     = 30
#         transition_glacier_days = 90
#         
#         abort_incomplete_multipart_upload_days = 7
#       }
#     ]
#     
#     additional_tags = {
#       purpose = "file-uploads"
#     }
#   }
# }

